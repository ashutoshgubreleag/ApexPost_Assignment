{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://apexpost.example/api",
    "Audience": "apexpost-api",
    "AccessTokenMinutes": 60,
    "ClockSkewSeconds": 30
  },
  "Database": {
    "MaxRetryCount": 3,
    "LogSqlCommands": false
  }
}
