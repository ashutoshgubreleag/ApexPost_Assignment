<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console consumer of the generated SDK: proves the client works against a running ApexPost.Api.
       Run:  dotnet run -p .\ApexPost.Client.Consumer -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\ApexPost.Client\Generated\ApexPostClient.g.cs')">
    <DefineConstants>$(DefineConstants);HAS_GENERATED_CLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Client\ApexPost.Client.csproj" />
  </ItemGroup>
</Project>
