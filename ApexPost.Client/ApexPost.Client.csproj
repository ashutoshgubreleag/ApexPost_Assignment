<Project Sdk="Microsoft.NET.Sdk">
  <!-- Client SDK for the ApexPost Logistics API (version 2), generated by NSwag from contracts/v2.json.
       Generated/ApexPostClient.g.cs is produced by scripts/generate-client.ps1 and is committed, so a build never needs the API running.
       Until that file exists this project builds as an empty library. Nothing in Generated/ is edited by hand: change the API, re-export, regenerate. -->
  <PropertyGroup>
    <RootNamespace>ApexPost.Client</RootNamespace>
    <!-- NSwag output is not written to our warning-free standard: relax it for this project only. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625;CS8600;CS8603;CS8604;CS8601;CS0108;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\Generated\ApexPostClient.g.cs')">
    <DefineConstants>$(DefineConstants);HAS_GENERATED_CLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
</Project>
