<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline-first counter terminal (console). Layers inside the project:
      Ui (console) → Application (TerminalService, SyncWorker, ports) → Infrastructure
      (Couchbase Lite stores, change monitor, HTTP sync client). Couchbase types never appear
      above Infrastructure. Uses the shared domain value objects and the sync wire contracts.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>apexpost-counter-terminal-7b2e41d9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Couchbase.Lite" Version="4.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Models\ApexPost.Models.csproj" />
    <ProjectReference Include="..\ApexPost.Contracts\ApexPost.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.CounterTerminal.Tests" />
  </ItemGroup>
</Project>
