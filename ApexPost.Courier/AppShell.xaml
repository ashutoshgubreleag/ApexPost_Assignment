<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ApexPost.Courier.Pages"
       x:Class="ApexPost.Courier.AppShell"
       Title="ApexPost Courier"
       FlyoutBehavior="Disabled">

    <ShellContent Route="Login" ContentTemplate="{DataTemplate pages:LoginPage}" />

    <TabBar Route="Main">
        <ShellContent Title="New scan" Route="NewScan" ContentTemplate="{DataTemplate pages:NewScanPage}" />
        <ShellContent Title="Pending" Route="Pending" ContentTemplate="{DataTemplate pages:PendingScansPage}" />
        <ShellContent Title="Sync" Route="Sync" ContentTemplate="{DataTemplate pages:SyncStatusPage}" />
    </TabBar>
</Shell>
