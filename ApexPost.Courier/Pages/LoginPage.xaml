<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:ApexPost.Courier.Pages"
             x:Class="ApexPost.Courier.Pages.LoginPage"
             Title="Sign in">
    <Grid RowDefinitions="Auto,*">
        <pages:OfflineBanner x:Name="Banner" />
        <VerticalStackLayout Grid.Row="1" Padding="24" Spacing="12" VerticalOptions="Center" MaximumWidthRequest="420">
            <Label Text="ApexPost Courier" FontSize="26" FontAttributes="Bold" />
            <Entry x:Name="UserEntry" Placeholder="User name" Text="courier1" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
            <Button x:Name="SignInButton" Text="Sign in" Clicked="OnSignIn" />
            <Label x:Name="ErrorLabel" TextColor="Firebrick" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
