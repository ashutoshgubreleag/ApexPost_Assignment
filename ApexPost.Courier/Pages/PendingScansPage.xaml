<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:ApexPost.Courier.Pages"
             x:Class="ApexPost.Courier.Pages.PendingScansPage"
             Title="Pending scans">
    <Grid RowDefinitions="Auto,Auto,*">
        <pages:OfflineBanner x:Name="Banner" />
        <Label x:Name="Header" Grid.Row="1" Padding="12" FontAttributes="Bold" />
        <CollectionView x:Name="List" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="12,6">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Detail}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Nothing waiting. Every scan is uploaded." Padding="12" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
