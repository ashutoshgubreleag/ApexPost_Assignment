<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:ApexPost.Courier.Pages"
             x:Class="ApexPost.Courier.Pages.SyncStatusPage"
             Title="Sync status">
    <Grid RowDefinitions="Auto,*">
        <pages:OfflineBanner x:Name="Banner" />
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="8" MaximumWidthRequest="520">
            <Label x:Name="NetworkLabel" />
            <Label x:Name="CircuitLabel" />
            <Label x:Name="PendingLabel" />
            <Label x:Name="LastAttemptLabel" />
            <Label x:Name="LastSuccessLabel" />
            <Label x:Name="MessageLabel" FontAttributes="Italic" />
            <Button x:Name="SyncButton" Text="Sync now" Clicked="OnSyncNow" />
            <Button Text="Sign out" Clicked="OnSignOut" BackgroundColor="Gray" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
