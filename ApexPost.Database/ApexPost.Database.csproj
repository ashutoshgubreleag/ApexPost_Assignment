<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Persistence model (part of the brief's "Infrastructure"): ApexPostDbContext, one
    IEntityTypeConfiguration per entity (Fluent API), value converters, persistence-only records,
    code-first migrations, reference-data seed and the T-SQL objects (stored procedures, app role)
    that the migrations deploy. References only the domain.
  -->
  <PropertyGroup>
    <!-- Lets the dotnet-ef CLI use this library as its own startup project (design-time factory). -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!--
      Security pin: Microsoft.Data.SqlClient 6.1.x brings System.Security.Cryptography.Pkcs 9.0.11,
      which is affected by CVE-2026-84008 (GHSA-846f-f764-76mx, high) and GHSA-2fmv-rv2c-59x7 (moderate).
      NuGet audit turns that into a build error (TreatWarningsAsErrors). 10.0.13 is the patched release;
      referencing it here makes every project that uses ApexPost.Database resolve the fixed version.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Models\ApexPost.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference data (fictional) used by HasData in the migrations and by the in-memory test fakes. -->
    <EmbeddedResource Include="Seed\*.json" LogicalName="ApexPost.Seed.%(Filename).json" />
    <!-- T-SQL deployed by the AddStoredProcedures migration (CREATE OR ALTER, so re-runnable). -->
    <EmbeddedResource Include="Sql\**\*.sql" LogicalName="ApexPost.Sql.%(Filename).sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Repositories" />
    <InternalsVisibleTo Include="ApexPost.Tests" />
  </ItemGroup>
</Project>
