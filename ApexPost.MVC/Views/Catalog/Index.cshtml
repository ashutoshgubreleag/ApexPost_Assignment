@model IReadOnlyList<ApexPost.Services.Abstractions.CatalogueItem>
@{
    ViewData["Title"] = "Catalogue and stock";
    var branch = ViewData["Branch"] as string ?? "";
    var category = ViewData["Category"] as ProductCategory?;
    var canAdjust = User.StaffRole == StaffRole.Administrator || (User.StaffRole == StaffRole.BranchManager && User.BranchCode.Value == branch);
}
<div class="page-head">
    <div>
        <h1>Catalogue and stock</h1>
        <p class="lead">Retail products with stock on hand at <span class="mono">@branch</span>. Prices exclude tax.</p>
    </div>
    <form method="get" asp-action="Index" class="row">
        @if (User.CanSeeAllBranches)
        {
            <input type="text" name="branch" value="@branch" placeholder="BR-001" aria-label="Branch" />
        }
        <select name="category" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<ProductCategory>())
            {
                <option value="@c" selected="@(category == c)">@c</option>
            }
        </select>
        <button class="btn secondary" type="submit">Filter</button>
    </form>
</div>
<div class="card table-wrap">
    <table>
        <thead><tr><th>SKU</th><th>Product</th><th>Category</th><th class="num">Price</th><th>Tax</th><th class="num">On hand</th><th class="num">Reorder at</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="mono">@item.Product.Sku</td>
                    <td>@item.Product.Name</td>
                    <td>@item.Product.Category</td>
                    <td class="num">@item.Product.UnitPrice</td>
                    <td>@item.Product.TaxCategory</td>
                    <td class="num">@item.QuantityOnHand</td>
                    <td class="num">@item.ReorderThreshold</td>
                    <td>@if (item.IsLowStock) { <span class="badge warn">Low</span> }</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (canAdjust)
{
    <div class="card mt">
        <h2>Adjust stock</h2>
        <form asp-action="AdjustStock" method="post" class="form-grid">
            <input type="hidden" name="BranchCode" value="@branch" />
            <div>
                <label for="adj-sku">Product</label>
                <select id="adj-sku" name="Sku">
                    @foreach (var item in Model)
                    {
                        <option value="@item.Product.Sku.Value">@item.Product.Sku · @item.Product.Name</option>
                    }
                </select>
            </div>
            <div><label for="adj-qty">Change (+ receive, − write off)</label><input id="adj-qty" type="number" name="QuantityChange" value="10" min="-1000" max="1000" /></div>
            <div><label for="adj-reason">Reason</label><input id="adj-reason" type="text" name="Reason" placeholder="Delivery from DC" /></div>
            <div><label>&nbsp;</label><button type="submit" class="btn">Apply</button></div>
        </form>
    </div>
}
@if (User.StaffRole == StaffRole.Administrator)
{
    <div class="card mt">
        <h2>Revise prices (whole category)</h2>
        <p class="help">One set-based UPDATE in the database (ExecuteUpdateAsync); the counters pick up the new prices on their next sync.</p>
        <form asp-action="RevisePrices" method="post" class="form-grid">
            <div>
                <label for="rev-cat">Category</label>
                <select id="rev-cat" name="Category" asp-items="Html.GetEnumSelectList<ProductCategory>()"></select>
            </div>
            <div><label for="rev-pct">Change %</label><input id="rev-pct" type="number" name="PercentChange" value="5" min="-50" max="50" step="0.5" /></div>
            <div><label for="rev-reason">Reason</label><input id="rev-reason" type="text" name="Reason" placeholder="Supplier price increase" /></div>
            <div><label>&nbsp;</label><button type="submit" class="btn" data-confirm="Revise all prices in this category?">Revise</button></div>
        </form>
    </div>
}
