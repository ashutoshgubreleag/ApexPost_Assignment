    ApexPost.Database; nothing depends on it except the composition root.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Database\ApexPost.Database.csproj" />
    <ProjectReference Include="..\ApexPost.Services\ApexPost.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Tests" />
  </ItemGroup>
</Project>
