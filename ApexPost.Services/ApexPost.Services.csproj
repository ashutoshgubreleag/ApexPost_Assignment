<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Application layer (the brief's "Application"): use cases, business rules, DTOs and the
    persistence ports (repository, unit of work and query interfaces). It references only the
    domain (ApexPost.Models); EF Core lives in ApexPost.Repositories / ApexPost.Database, which
    implement these interfaces. Microsoft.Extensions.* come from the shared framework.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Models\ApexPost.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Tests" />
  </ItemGroup>
</Project>
